# Server Configuration
PORT=8001
HOST=127.0.0.1
DEBUG=True

# Qdrant Configuration (Runs embedded on local disk by default; no Docker required)
QDRANT_STORAGE_PATH=./qdrant_storage
QDRANT_COLLECTION_NAME=policy_documents

# LLM Configuration
# Set MOCK_LLM=true for offline testing; set to false when LLM_API_KEY is provided
MOCK_LLM=true
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Embedding Model
EMBEDDING_PROVIDER=local
